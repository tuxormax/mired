#!/bin/sh
# Se ejecuta antes de quitar el paquete: detiene los servicios.
set -e

case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop mired-servidor >/dev/null 2>&1 || true
            systemctl stop mired-sonda >/dev/null 2>&1 || true
            systemctl disable mired-servidor >/dev/null 2>&1 || true
            systemctl disable mired-sonda >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0

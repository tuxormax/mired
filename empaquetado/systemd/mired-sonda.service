[Unit]
Description=MiRed — sonda de escaneo de red
Documentation=https://github.com/tuxormax/mired
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mired-sonda --configuracion /etc/mired/mired.toml
Restart=on-failure
RestartSec=5

# La sonda necesita red cruda para el barrido ARP y los sondeos, pero NO se le da
# root entero: solo las dos capacidades que hacen falta. Y no toca ninguna base
# de datos, asi que aunque algo saliera mal no puede corromper los datos.
User=mired
Group=mired
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# El socket por donde la escucha el servidor. Se conserva al reiniciar la sonda
# para no dejar al servidor sin carpeta a la mitad.
RuntimeDirectory=mired
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
